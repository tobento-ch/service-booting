{
    "name": "tobento/service-booting",
    "version": "2.0",
    "type": "library",
    "description": "Booting manager for creating PHP applications.",
    "keywords": [
        "tobento",
        "package",
        "booting",
        "booter"
	],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "psr/container": "^2.0",
        "tobento/service-autowire": "^2.0"
    },
    "suggest": {
        "tobento/service-container": "PSR-11 container with autowiring"
    },    
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "tobento/service-container": "^2.0",
        "symfony/dependency-injection": "^7.3",
        "league/container": "^5.1"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\Service\\Booting\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\Service\\Booting\\Test\\": "tests",
            "Tobento\\Demo\\Booting\\": "demo/src"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}